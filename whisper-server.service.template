# Template — placeholders are substituted by intel-gpu-inference/install.sh:
#   __INSTALL_DIR__  → absolute path to the intel-gpu-inference directory
#   __HOME__         → user's home directory
#
# Do not edit the installed unit directly (~/.config/systemd/user/whisper-server.service).
# Edit this file and re-run: intel-gpu-inference/install.sh --with-whisper

[Unit]
Description=whisper.cpp SYCL speech recognition server (English/French, Intel Arc A770)
After=network.target llama-server.service embedding-server.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=-__HOME__/.config/intel-gpu-inference/env
WorkingDirectory=__INSTALL_DIR__
ExecStartPre=__INSTALL_DIR__/scripts/wait-for-model-load.sh llama-server.service:8080 embedding-server.service:8002
ExecStart=__INSTALL_DIR__/scripts/run-whisper.sh
ExecStartPost=__INSTALL_DIR__/scripts/warmup-whisper.sh
Restart=always
RestartSec=5
TimeoutStartSec=600
OOMScoreAdjust=900

[Install]
WantedBy=default.target
