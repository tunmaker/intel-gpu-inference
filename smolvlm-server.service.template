# Template — placeholders are substituted by intel-gpu-inference/install.sh:
#   __INSTALL_DIR__  → absolute path to the intel-gpu-inference directory
#   __HOME__         → user's home directory
#
# Do not edit the installed unit directly (~/.config/systemd/user/smolvlm-server.service).
# Edit this file and re-run: intel-gpu-inference/install.sh --with-smolvlm

[Unit]
Description=SmolVLM-256M scene captioner for the presence gate (CPU)
After=network.target llama-server.service
Wants=llama-server.service

[Service]
Type=simple
EnvironmentFile=-__HOME__/.config/intel-gpu-inference/env
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/scripts/run-smolvlm.sh
Restart=always
RestartSec=5
TimeoutStartSec=120

# CPU, not the A770 and not the iGPU. Measured 1 Sep 2026 on a 0.6B model:
#   CPU  4 threads .... 707 t/s prefill, 58 t/s generate
#   CPU  8 threads .... 578 t/s prefill, 66 t/s generate
#   iGPU (UHD 770) .... 118 t/s prefill, 26 t/s generate
# The iGPU works and loses by 6x on prefill, so the only reason to use it would
# be to spare CPU, and this model needs very little of that.
#
# Four threads leaves the box's other four for llama-server's host-side work.
CPUQuota=400%

# The model is 175 MB, the projector 104 MB and lives in VRAM, and the rest is
# decode scratch. This host has 10 GB total and llama-server's prompt cache wants
# most of the slack, so the captioner is capped rather than left to compete.
MemoryHigh=1G
MemoryMax=1500M

NoNewPrivileges=true

[Install]
WantedBy=default.target
