# Intel Arc GPU — user configuration
# This file is loaded by llama-server.service as EnvironmentFile.
# For full environment (oneAPI, GPU settings), see: ~/.config/intel-gpu-inference/env
# Override any value from that file here if needed.

# Models directory
MODELS_DIR=__HOME__/models

# Active model (path to .gguf file)
DEFAULT_MODEL=__HOME__/models/Qwen3.8-27B/Qwen3.8-27B-UD-IQ4_XS.gguf

# Vision projector — leave blank to disable multimodal
MMPROJ_PATH=__HOME__/models/Qwen3.8-27B/mmproj-F16.gguf

# Context window; run.sh falls back to 131072, which the 27B cannot hold
DEFAULT_CTX=49152

# Server bind address and port
LLAMA_HOST=0.0.0.0
LLAMA_PORT=8080
