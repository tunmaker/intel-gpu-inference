# Piper neural text-to-speech server configuration
# Appended to ~/.config/intel-gpu-inference/env by scripts/install-piper.sh
# For full options, see: https://github.com/OHF-Voice/piper1-gpl

# === Piper Text-to-Speech ===

# Directory holding the .onnx / .onnx.json voice pairs
PIPER_VOICES_DIR=__HOME__/models/piper

# Voice loaded at startup and used when a request omits "voice".
# Any other voice in PIPER_VOICES_DIR is loaded on first use, no restart needed.
PIPER_VOICE=en_US-lessac-medium

# Server bind address and port
PIPER_HOST=0.0.0.0
PIPER_PORT=9091

# onnxruntime intra-op threads. These voices are too small to parallelise, so
# capping the pool costs almost no latency while keeping RSS and CPU contention
# with llama-server down. Set 0 to restore upstream's core-count default.
PIPER_NUM_THREADS=2

# Default speaking rate. Below 1.0 is faster; overridable per request.
PIPER_LENGTH_SCALE=1.0
