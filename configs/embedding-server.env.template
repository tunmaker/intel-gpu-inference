# llama.cpp embedding server configuration
# Appended to ~/.config/intel-gpu-inference/env by scripts/install-embedding.sh
# For full options, see: https://github.com/ggml-org/llama.cpp/blob/master/examples/server/README.md

# === llama.cpp Embedding Server ===

# Embedding model (path to .gguf file). BGE-M3 Q8_0: 1024-dim, 8192 ctx,
# multilingual. Grab it with:
#   huggingface-cli download gpustack/bge-m3-GGUF bge-m3-Q8_0.gguf --local-dir ~/models
EMBEDDING_MODEL=__HOME__/models/bge-m3-q8_0.gguf

# Pooling mode. Must match the model: `cls` for the BGE family, `last` for
# Qwen3-Embedding and other decoder-style embedders, `mean` for E5/GTE.
# A mismatch yields plausible-looking but wrong vectors — no error is raised.
EMBEDDING_POOLING=cls

# Server bind address and port
EMBEDDING_HOST=0.0.0.0
EMBEDDING_PORT=8085

# Per-slot context. llama-server's -c is the TOTAL across slots, so
# run-embedding.sh passes EMBEDDING_CTX * EMBEDDING_PARALLEL.
# BGE-M3 accepts up to 8192; 4096 covers most chunking schemes and halves KV.
EMBEDDING_CTX=4096

# Parallel decode slots
EMBEDDING_PARALLEL=4
