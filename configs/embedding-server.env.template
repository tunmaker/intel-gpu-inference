# llama.cpp embedding server configuration
# Appended to ~/.config/intel-gpu-inference/env by scripts/install-embedding.sh
# For full options, see: https://github.com/ggml-org/llama.cpp/blob/master/examples/server/README.md

# === llama.cpp Embedding Server ===

# Embedding model (path to .gguf file)
EMBEDDING_MODEL=__HOME__/models/Qwen3-Embedding-0.6B-Q8_0.gguf

# Pooling mode. Must match the model: `last` for Qwen3-Embedding and other
# decoder-style embedders, `cls` for the BGE family, `mean` for E5/GTE.
# A mismatch yields plausible-looking but wrong vectors — no error is raised.
EMBEDDING_POOLING=last

# Server bind address and port
EMBEDDING_HOST=0.0.0.0
EMBEDDING_PORT=8085

# Per-slot context. llama-server's -c is the TOTAL across slots, so
# run-embedding.sh passes EMBEDDING_CTX * EMBEDDING_PARALLEL.
EMBEDDING_CTX=8192

# Parallel decode slots
EMBEDDING_PARALLEL=2
