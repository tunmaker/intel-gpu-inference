# Vosk speech recognition server configuration (Tunisian Derja)
# Appended to ~/.config/intel-gpu-inference/env by scripts/install-vosk.sh
# For full options, see: https://alphacephei.com/vosk/

# === Vosk Speech Recognition ===

# Unpacked model directory (not the .zip)
VOSK_MODEL=__HOME__/models/vosk/vosk-model-ar-tn-0.1-linto

# Server bind address and port
VOSK_HOST=0.0.0.0
VOSK_PORT=9092

# Reject uploads larger than this before reading them into memory
VOSK_MAX_UPLOAD_MB=256
