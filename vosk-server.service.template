# Template — placeholders are substituted by intel-gpu-inference/install.sh:
#   __INSTALL_DIR__  → absolute path to the intel-gpu-inference directory
#   __HOME__         → user's home directory
#
# Do not edit the installed unit directly (~/.config/systemd/user/vosk-server.service).
# Edit this file and re-run: intel-gpu-inference/install.sh --with-vosk

[Unit]
Description=Vosk Kaldi speech recognition server, Tunisian Derja (CPU)
After=network.target llama-server.service embedding-server.service

[Service]
Type=simple
EnvironmentFile=-__HOME__/.config/intel-gpu-inference/env
WorkingDirectory=__INSTALL_DIR__
ExecStartPre=__INSTALL_DIR__/scripts/wait-for-model-load.sh llama-server.service:8080 embedding-server.service:8085
ExecStart=__INSTALL_DIR__/scripts/run-vosk.sh
Restart=always
RestartSec=5
TimeoutStartSec=180

# See the MemoryMax note in scripts/install-vosk.sh. Sized from the measured
# resident set of the loaded model plus decoding headroom, so this service is
# capped explicitly rather than letting the container's cgroup pick a victim.
MemoryHigh=__VOSK_MEM_HIGH__
MemoryMax=__VOSK_MEM_MAX__

# Kaldi's beam search will take every core it is given; bound it so a burst
# cannot starve llama-server.
CPUQuota=200%

# Sacrifice order under memory pressure:
#   llama-server 0 (the active model, must not be disturbed)
#   embedding-server 500 < piper-server 700 < vosk-server 800
# With whisper-server retired, vosk is the highest score and therefore the first
# service the kernel kills — deliberate: it is the only one that can be lost
# without taking chat, embeddings or speech output down with it. A reload costs a
# model load rather than the ~2s piper needs, which is why it sits above piper.
OOMScoreAdjust=800

StartLimitIntervalSec=60
StartLimitBurst=3

[Install]
WantedBy=default.target
